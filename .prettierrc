{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrder": [
    "<THIRD_PARTY_MODULES>",
    "^(\\.\\.?/)+types(?:/.*)?$",
    "^(\\.\\.?/)+utils(?:/.*)?$",
    "^(\\.\\.?/)+constants(?:/.*)?$",
    "^(\\.\\.?/)+rules(?:/.*)?$",
    "^[./]"
  ]
}