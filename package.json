{
  "name": "@prismalyst/core",
  "version": "0.1.0",
  "description": "Core engine and shared contracts for Prismalyst static analysis tools.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prismalyst/core"
  },
  "homepage": "https://github.com/Prismalyst",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && npx rollup dist/index.js --file dist/index.cjs --format cjs",
    "watch": "tsc -w",
    "pack": "npm pack",
    "pack:check": "npm pack --dry-run",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "typecheck": "npx tsc --noEmit",
    "prisma:v7:generate": "npx prisma generate --schema ./src/tests/schemas/v7"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <7"
  },
  "dependencies": {
    "@prisma/dmmf": "^7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "rollup": "^4.66.0",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}